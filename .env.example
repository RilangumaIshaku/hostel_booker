[TEMPLATE]
# Dashboard and worker service configuration. Never put student portal logins here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
PORTAL_DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key

WORKER_ID=hostel-booker-worker-1
WORKER_IDLE_POLL_MS=60000
WORKER_RUSH_POLL_MS=1000

# Claim a job before its start time so the worker can sign in and pre-warm.
PORTAL_CLAIM_LEAD_SECONDS=150
PORTAL_JOB_WINDOW_MINUTES=10
PORTAL_POLL_MS=800

SESSION_CHECK_ENABLED=false
# The live-booking switch. Turn on only after npm run portal:fees succeeds.
BOOKING_AUTOMATION_ENABLED=false

# Optional: captured page URLs, supplied as JSON (no credentials).
# PORTAL_FLOW_SPEC={"version":1,"pages":{"accommodation":{"url":"https://eportal.futminna.edu.ng/ePortal_V2/std/..."}}}
# Or a path to .portal/portal-flow.json in the worker workspace.
# PORTAL_FLOW_SPEC_PATH=.portal/portal-flow.json

# Local race-day runner only. Use .env.local and never set these on a shared server.
# PORTAL_USERNAME=
# PORTAL_PASSWORD=
# PORTAL_START=2026-11-06T09:00:00+01:00
